# Copy to .env and fill in. NEVER commit .env.
# Keep comments on their own lines: Docker reads `KEY=value  # note` as the value "value  # note".
# Most keys can instead be entered in /admin → Integrations.
# --- server / database ---
# docker compose: Caddy gets HTTPS for this domain
DOMAIN=os.example.com
PUBLIC_URL=https://os.example.com
POSTGRES_PASSWORD=change-me-long-random
# DATABASE_URL is set by docker-compose; for a plain Node host set it yourself:
# DATABASE_URL=postgresql://bos:change-me@localhost:5432/business_os
# openssl rand -base64 32  (SESSION_SECRET also works)
AUTH_SECRET=
# only this email can create the first owner account at /setup
ADMIN_EMAIL=you@example.com

# --- AI ---
# AI Assistant, InboxPilot replies, image->text
ANTHROPIC_API_KEY=
# chat + inbox
ANTHROPIC_MODEL=claude-haiku-5-5
# "Gobhir chinta" + weekly AI jobs
ANTHROPIC_MODEL_COMPLEX=claude-opus-5-5
# on = worker runs weekly growth/competitor, loan plan, learning nudge
AI_JOBS=off

# --- Meta (InboxPilot) ---
# Kids Care BD
META_PAGE_ID=100610659355780
# Page access token (Messenger send/read)
META_PAGE_TOKEN=
# verify X-Hub-Signature-256 on webhooks
META_APP_SECRET=
META_VERIFY_TOKEN=kidscare2026

# --- Nuport (Kids Care orders) ---
NUPORT_API_KEY=
# first run only: the last SO number already in sales_daily
NUPORT_START_SO=

# --- Google Sheets sales-team sync (sheets shared with the service account email) ---
# the JSON key, raw or base64
GOOGLE_SERVICE_ACCOUNT_JSON=
# Call System sheet id
KC_SHEET_CALL_LIVE=
# gid of its Live_Dashboard tab
KC_SHEET_CALL_LIVE_GID=
# Up-sales tracker sheet id
KC_SHEET_UPSALES=
# Staff daily report sheet id
KC_SHEET_DAILY=
# optional: old Call System v6
KC_SHEET_V6=
# optional: old Up-sales tracker
KC_SHEET_UPS_OLD=

# --- optional ---
# FB ads / page insights in the dashboard
SUPERMETRICS_API_KEY=
# nightly pg_dump files to keep
BACKUP_KEEP=14
