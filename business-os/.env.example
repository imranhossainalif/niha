# Copy to .env and fill in. NEVER commit .env.
# --- server / database ---
DOMAIN=os.example.com                 # docker compose: Caddy gets HTTPS for this domain
PUBLIC_URL=https://os.example.com
POSTGRES_PASSWORD=change-me-long-random
# DATABASE_URL is set by docker-compose; for a plain Node host set it yourself:
# DATABASE_URL=postgresql://bos:change-me@localhost:5432/business_os
AUTH_SECRET=                          # openssl rand -base64 32  (SESSION_SECRET also works)
ADMIN_EMAIL=you@example.com          # only this email can create the first owner account at /setup

# --- AI ---
ANTHROPIC_API_KEY=                    # AI Assistant, InboxPilot replies, image->text
ANTHROPIC_MODEL=claude-haiku-5-5      # chat + inbox
ANTHROPIC_MODEL_COMPLEX=claude-opus-5-5 # "Gobhir chinta" + weekly AI jobs
AI_JOBS=off                           # on = worker runs weekly growth/competitor, loan plan, learning nudge

# --- Meta (InboxPilot) ---
META_PAGE_ID=100610659355780          # Kids Care BD
META_PAGE_TOKEN=                      # Page access token (Messenger send/read)
META_APP_SECRET=                      # verify X-Hub-Signature-256 on webhooks
META_VERIFY_TOKEN=kidscare2026

# --- Nuport (Kids Care orders) ---
NUPORT_API_KEY=
NUPORT_START_SO=                      # first run only: the last SO number already in sales_daily

# --- Google Sheets sales-team sync (sheets shared with the service account email) ---
GOOGLE_SERVICE_ACCOUNT_JSON=          # the JSON key, raw or base64
KC_SHEET_CALL_LIVE=                   # Call System sheet id
KC_SHEET_CALL_LIVE_GID=               # gid of its Live_Dashboard tab
KC_SHEET_UPSALES=                     # Up-sales tracker sheet id
KC_SHEET_DAILY=                       # Staff daily report sheet id
KC_SHEET_V6=                          # optional: old Call System v6
KC_SHEET_UPS_OLD=                     # optional: old Up-sales tracker

# --- optional ---
SUPERMETRICS_API_KEY=                 # FB ads / page insights in the dashboard
BACKUP_KEEP=14                        # nightly pg_dump files to keep
